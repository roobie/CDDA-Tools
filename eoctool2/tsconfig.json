{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@generated/*": ["./generated/*"]
    },
    "types": ["node"],
    "lib": ["ESNext"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "outDir": "node_modules/__dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*", "spec/**/*", "generated/**/*"]
}
